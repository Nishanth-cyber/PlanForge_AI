# PlanForge AI Environment Configuration
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# LLM Provider Configuration
# Supported providers:
#   - "google"      : Google AI Studio / Gemini API (primary fast reasoning provider)
#   - "openrouter"  : OpenRouter API (OpenAI-compatible) with top open & frontier models
#   - "huggingface" : Hugging Face Inference API / Router
#   - "mock"        : Deterministic mock generator (offline, reproducible testing)
# ==============================================================================
PLANFORGE_LLM_PROVIDER=google

# ==============================================================================
# Google Gemini Configuration (when PLANFORGE_LLM_PROVIDER=google)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
# ==============================================================================
PLANFORGE_GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Verified Gemini Flash models:
#   - "gemini-flash-latest"    (Recommended: ultra-fast production Flash model)
#   - "gemini-2.0-flash"       (High throughput, structured output)
#   - "gemini-3.8-flash"       (Latest generation reasoning flash)
PLANFORGE_LLM_MODEL=gemini-flash-latest

# Optional secondary fallback provider when Gemini quota is exhausted (e.g., "openrouter")
PLANFORGE_FALLBACK_PROVIDER=openrouter

# Retry and timeout settings
PLANFORGE_LLM_MAX_RETRIES=3
PLANFORGE_LLM_RETRY_DELAY=1.0
PLANFORGE_LLM_TIMEOUT=120.0

# ==============================================================================
# OpenRouter Configuration (when PLANFORGE_LLM_PROVIDER=openrouter or as fallback)
# OpenRouter API Key (get from openrouter.ai/settings/keys)
# ==============================================================================
PLANFORGE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Recommended OpenRouter models:
#   - "meta-llama/llama-3.3-70b-instruct"    (High reasoning quality, low cost)
#   - "deepseek/deepseek-chat"                (DeepSeek-V3, architectural planning & JSON)
#   - "google/gemini-2.0-flash-001"           (Fastest latency, structured output)
PLANFORGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
PLANFORGE_OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free
PLANFORGE_OPENROUTER_MAX_RETRIES=3
PLANFORGE_OPENROUTER_RETRY_DELAY=1.0
PLANFORGE_OPENROUTER_ALLOW_FALLBACKS=true

# Optional OpenRouter attribution headers
# PLANFORGE_OPENROUTER_HTTP_REFERER=https://planforge.ai
# PLANFORGE_OPENROUTER_TITLE=PlanForge AI

# ==============================================================================
# Hugging Face Configuration (when PLANFORGE_LLM_PROVIDER=huggingface)
# ==============================================================================
# PLANFORGE_HF_BASE_URL=https://router.huggingface.co/v1/chat/completions
# PLANFORGE_HF_API_KEY=hf_your_free_huggingface_token_here

# ==============================================================================
# Shared Sampling & Generation Settings
# ==============================================================================
PLANFORGE_LLM_TEMPERATURE=0.2
PLANFORGE_LLM_MAX_TOKENS=4096
