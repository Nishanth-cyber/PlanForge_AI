# PlanForge AI Environment Configuration
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# LLM Provider Configuration
# Supported providers:
#   - "huggingface" : Free Serverless Hugging Face Inference API with DeepSeek model
#   - "mock"        : Deterministic mock generator (offline, reproducible testing)
# ==============================================================================
PLANFORGE_LLM_PROVIDER=huggingface

# Model Name:
# Recommended DeepSeek models:
#   - "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B" (Fast, high quality reasoning & JSON)
#   - "deepseek-ai/DeepSeek-V3"
#   - "deepseek-ai/DeepSeek-R1-Distill-Llama-8B"
PLANFORGE_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Hugging Face Inference Endpoint Configuration
# Standard model inference endpoint:
PLANFORGE_HF_BASE_URL=https://api-inference.huggingface.co/models
# Or OpenAI-compatible router endpoint:
# PLANFORGE_HF_BASE_URL=https://router.huggingface.co/hf-inference/v1/chat/completions

# Hugging Face API Key / Token (Free user access token from huggingface.co/settings/tokens)
# PLANFORGE_HF_API_KEY=hf_your_free_huggingface_token_here

# Request Timeout in seconds (120.0s recommended for remote API)
PLANFORGE_LLM_TIMEOUT=120.0

# Sampling parameters
PLANFORGE_LLM_TEMPERATURE=0.2
PLANFORGE_LLM_MAX_TOKENS=4096
